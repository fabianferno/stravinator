# Render worker image: Chromium (via Playwright) + ffmpeg + Node 22.
#
# Built on the plain Node image rather than mcr.microsoft.com/playwright.
# That base is convenient but costs ~1.5 GB of Firefox and WebKit the worker
# never launches, and its browsers cannot be deleted afterwards to reclaim the
# space — they live in a lower layer, so an `rm` only adds another layer on top.
# It also ships Node 24, drifting from the Node 22 used in development and CI.
#
# `playwright install --with-deps chromium` pulls exactly one browser and
# exactly the system libraries it needs.
FROM node:22-bookworm-slim

# ffmpeg is the encoder. Playwright bundles a private ffmpeg build for its own
# video recording, but that one cannot be invoked as a CLI, so install the real
# thing. ca-certificates is needed for the browser download below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    WORK_DIR=/data

WORKDIR /app

# Dependencies first so a source-only change does not reinstall the world.
COPY package.json package-lock.json ./
# devDependencies are required at runtime: the worker runs through `tsx`, and
# Playwright itself is a devDependency.
RUN npm ci --include=dev

# worker/capture.ts launches with `channel: "chromium"` — the full Chromium
# build, not chromium-headless-shell, whose WebGL is too weak for 3D terrain.
# `playwright install chromium` provides exactly that channel. `--with-deps`
# installs the system libraries Chromium needs, which the slim base lacks.
RUN npx playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# Tile cache and finished videos live here. Mount a persistent volume: terrain
# tiles bill per request, so an empty cache on every boot costs real money.
# (Finished MP4s are also served from this disk today — see docs/deploy.md.)
RUN mkdir -p /data/tile-cache /data/out
VOLUME ["/data"]

CMD ["npm", "run", "worker"]
